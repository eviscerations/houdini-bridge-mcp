diff --git a/cmake/modules/FindHoudiniUSD.cmake b/cmake/modules/FindHoudiniUSD.cmake
index 24c4aa8..6f486f1 100644
--- a/cmake/modules/FindHoudiniUSD.cmake
+++ b/cmake/modules/FindHoudiniUSD.cmake
@@ -213,6 +213,13 @@ if(HoudiniUSD_FOUND AND NOT TARGET hd)
     # more than enough to get it linked in for us.
     target_link_libraries(tf INTERFACE ${Houdini_Boostpython_LIB})
     target_link_libraries(vt INTERFACE ${Houdini_Boostpython_LIB})
+    # hdRpr-H21 patch: USD 25.05 renamed boost.python -> pxr_boost::python, and its converter/registry
+    # runtime is exported by Houdini's libpxr_python (NOT hboost_python above). Link it into tf/vt so
+    # tf/vt and everything downstream (incl. rprUsd) resolve pxr_boost::python::converter::* symbols.
+    if(EXISTS "${HOUDINI_ROOT}/custom/houdini/dsolib/libpxr_python.lib")
+        target_link_libraries(tf INTERFACE "${HOUDINI_ROOT}/custom/houdini/dsolib/libpxr_python.lib")
+        target_link_libraries(vt INTERFACE "${HOUDINI_ROOT}/custom/houdini/dsolib/libpxr_python.lib")
+    endif()
     if(APPLE)
         target_link_libraries(tf INTERFACE ${Houdini_TBB_LIB})
     endif(APPLE)
